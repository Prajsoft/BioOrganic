# ── Google Analytics 4 ──────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Ads ───────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=XXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=XXXXXXXXXXXXXXXXXXX

# ── Meta Pixel (client-side) ─────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# ── Meta CAPI (server-side, never exposed to browser) ─
META_CAPI_ACCESS_TOKEN=your_capi_token_here
META_TEST_EVENT_CODE=TEST00000

# ── Blog revalidation ────────────────────────────────
REVALIDATE_SECRET=your_secret_here

# ── Contact form ─────────────────────────────────────
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# ── WordPress (optional override) ───────────────────
WORDPRESS_API_BASE=https://bioorganicpestcontrol.in/wp-json/wp/v2
